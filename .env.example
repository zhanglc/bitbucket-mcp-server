# Bitbucket Server Configuration for Integration Tests
# Copy this file to .env and fill in your actual values

# Bitbucket Server URL (e.g., https://bitbucket.company.com)
BITBUCKET_BASE_URL=https://your-bitbucket-server.com

# Your Bitbucket username (full email for Server)
BITBUCKET_USERNAME=your.email@company.com

# Your Bitbucket HTTP Access Token (for Server) or App Password (for Cloud)
BITBUCKET_TOKEN=your-token-here

# Test Configuration
# Workspace/Project key to use for testing
TEST_WORKSPACE=your-workspace

# Repository name to use for testing
TEST_REPOSITORY=your-test-repo